# AegisSafety Platform - Environment Configuration Example
VITE_APP_TITLE="AegisSafety | Offline AI Women Safety Platform"
VITE_APP_ENV="development"

# Emergency Helplines
VITE_EMERGENCY_HELPLINE_NUMBER="1091"
VITE_POLICE_HELPLINE_NUMBER="112"

# Optional External API Keys (Leave blank for 100% free offline mode)
VITE_MAPBOX_ACCESS_TOKEN="your_mapbox_access_token_here"
VITE_OPENROUTESERVICE_API_KEY="your_openrouteservice_api_key_here"
VITE_TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
VITE_TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
VITE_TWILIO_PHONE_NUMBER="your_twilio_phone_number_here"
VITE_OPENAI_API_KEY="your_openai_api_key_here"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Feature Flags
VITE_ENABLE_AUDIO_SIREN=true
VITE_ENABLE_AUTO_RECORDING=true
VITE_ENABLE_SIMULATOR_PANEL=true
